# Copy to .env and fill in. Never commit .env.
# Write values WITHOUT surrounding quotes, one per line: DATABASE_URL=postgresql://...

# Neon pooled connection string (app runtime)
DATABASE_URL=
# Neon direct string (Alembic). Optional: if empty it is derived from DATABASE_URL by dropping "-pooler".
DATABASE_URL_DIRECT=
# Neon `test` branch (API tests against Postgres). Optional; tests use SQLite when empty.
TEST_DATABASE_URL=

# LLM: set the key of ONE provider. LLM_PROVIDER (gemini | anthropic) is only needed when both keys exist.
GEMINI_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=gemini
# Empty = the provider's default (gemini-3.5-flash / claude-opus-5-5)
LLM_MODEL=gemini-3.5-flash
# Gemini only: comma-separated models tried in order when the previous one is out of quota (free tier is
# a small daily quota per model). Leave the line out for the default chain; set it empty to disable.
# LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
